# Public — these three reach the browser. Keep localhost for local development;
# set NEXT_PUBLIC_SITE_URL=https://grep.team in Vercel Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server only — never prefix these with NEXT_PUBLIC_.
# Read by app/api/admin/auth-link/route.ts and nothing else.

# Required to create invited accounts and administrator-issued login links.
# Without it, invitations cannot complete. Supabase dashboard -> Settings ->
# API Keys -> secret key.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Optional. Leave both unset and the links are still created — the console shows
# them for you to pass on to the coach yourself. Set them and the same links go
# out by email instead. RESEND_FROM must be an address on a domain verified in
# Resend, or Resend refuses to deliver and you are back to passing links on by
# hand anyway.
RESEND_API_KEY=re_YOUR_KEY
RESEND_FROM=Grep <no-reply@grep.team>
