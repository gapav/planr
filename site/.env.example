# Public — these three reach the browser. Keep localhost for local development;
# set NEXT_PUBLIC_SITE_URL=https://grep.team in Vercel Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server only — never prefix these with NEXT_PUBLIC_.

# Bypasses RLS entirely, so exactly three server routes read it: creating
# invited accounts and login links (/api/admin/auth-link), permanently deleting
# an account (/api/admin/accounts), and the morning session email
# (/api/cron/daily-session-digest), which runs with nobody signed in. Without it,
# invitations cannot complete and the morning email is off. Supabase dashboard
# -> Settings -> API Keys -> secret key.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Optional. Leave both unset and the links are still created — the console shows
# them for you to pass on to the coach yourself. Set them and the same links go
# out by email instead. RESEND_FROM must be an address on a domain verified in
# Resend, or Resend refuses to deliver and you are back to passing links on by
# hand anyway.
RESEND_API_KEY=re_YOUR_KEY
RESEND_FROM=Grep <no-reply@grep.team>

# Optional. Where the in-app «Hjelp og support» messages and the /velkommen
# interest form go; both default to the owner's address. Both need
# RESEND_API_KEY and RESEND_FROM above.
GREP_SUPPORT_TO=
GREP_INTEREST_TO=

# Required by the scheduled morning email (`/api/cron/daily-session-digest`).
# Vercel attaches it to every cron invocation as `Authorization: Bearer …`;
# without it the route answers 503 and nothing is ever sent. It is the only
# thing standing between the internet and that route, so make it long and
# random — `openssl rand -base64 32` — and treat it like an admin password:
# whoever holds it can trigger the send, and `?dry=1` lists every recipient.
CRON_SECRET=
